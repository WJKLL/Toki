<?xml version="1.0" encoding="utf-8"?>
<!--
  F-10 今日课程卡（4x2）· **单一布局**（v1.51.4 起不再分亮/暗两份）。

  亮暗如何切换（v1.51.4 的关键变更）：
    所有颜色都是 @color 引用（见 res/values/colors.xml 与 values-night/colors.xml），
    没有任何 android:textColor 字面量，渲染器也不再下发 setTextColor。
    于是 Launcher 在系统深色模式切换时重新 inflate 本布局，资源系统会自动取到
    对应档位的颜色 —— **不需要任何东西来触发刷新**。

    为什么不能沿用「两套布局 + 运行时 setTextColor」：系统切换深色模式时不会通知
    AppWidgetProvider，而运行时下发的字面量色值又与 uiMode 脱钩，卡片就会一直停在
    旧配色直到 App 被打开。原 widget_today_courses_dark.xml 已因此删除。

  结构对齐鸿蒙版服务卡片（harmonyos_port 的 TodayCourseCard.ets）：
    标题行（今日课程 + 周次）→ 标签行（当前课程 / 下一节课 + 剩余分钟）
    → 课程名（大字视觉焦点）→ 教室行 → 下一节行

  **尺寸声明一律未动**（minWidth/minHeight/minResize*/targetCell* 仍是
  250x110dp / 4x2，见 widget_today_courses_info.xml）。

  兼容性红线（v1.36.0 桌面小组件失败的复盘结论，务必保持）：
    1. ViewGroup 嵌套 ≤ 2 层：根 LinearLayout + 两个行 LinearLayout；
    2. 无 Bitmap、无 Canvas、无自定义绘制元素，**不使用裸 <View>**；
    3. **不使用 ?attr 主题属性引用**（@color 静态资源查表不在此列 —— 它不需要在
       Launcher 进程解析本应用主题）；
    4. 不使用 RemoteViewsService / ListView 集合小组件。
  圆环倒计时：鸿蒙版为 Progress(Ring)，RemoteViews 画不出环形，
  故降级为等义文本（标签行右侧「剩余 N 分钟」）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <!-- ── 标题行：今日课程                    第 12 周 · 第 1 学期 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="今日课程"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="今日课程" />

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            tools:text="第 12 周 · 第 1 学期" />
    </LinearLayout>

    <!-- ── 标签行：当前课程                    剩余 40 分钟 ────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="11.5sp"
            tools:text="当前课程" />

        <TextView
            android:id="@+id/widget_remain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            tools:text="剩余 40 分钟" />
    </LinearLayout>

    <!-- ── 课程名（大字视觉焦点）────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="高等数学" />

    <!-- ── 教室行 ──────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11.5sp"
        tools:text="教室:A-301" />

    <!-- ── 下一节行 ────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11.5sp"
        tools:text="下一节课是:大学英语 09:50" />
</LinearLayout>
