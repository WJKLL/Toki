<?xml version="1.0" encoding="utf-8"?>
<!--
  F-10 今日课程卡（4x2）· 亮色版。

  v1.51.1 结构对齐鸿蒙版服务卡片（harmonyos_port 的 TodayCourseCard.ets）：
  由「今日课程三列列表」改为「当前 / 下一节课焦点卡」——
    标题行（今日课程 + 周次）
    → 标签行（当前课程 / 下一节课，强调色 + 右侧剩余分钟）
    → 课程名（大字视觉焦点）
    → 教室行
    → 下一节行
  **尺寸声明一律未动**（minWidth/minHeight/minResize*/targetCell* 仍是
  250x110dp / 4x2，见 widget_today_courses_info.xml）。

  v1.51.2 利用实机多出的高度（4x2 实际渲染 176dp，内容原仅约 106dp）：
    · 课程名 16sp → **22sp**（视觉比重贴近鸿蒙版的 20fp）；
    · 各行改为 marginBottom 分配间距（8 / 4 / 6 / 5dp），
      总内容约 141dp + padding 22dp，在 176dp 内上下各留约 17dp。
    · 间距用 margin 而非固定行高：空字段 GONE 时其 margin 一并塌陷，
      不会留下死空行；根 gravity=center_vertical 负责整块居中。

  兼容性红线（v1.36.0 桌面小组件失败的复盘结论，务必保持）：
    1. ViewGroup 嵌套 ≤ 2 层：根 LinearLayout + 两个行 LinearLayout；
    2. 无 Bitmap、无 Canvas、无自定义绘制元素，**不使用裸 <View>**；
    3. 布局内颜色全部是**字面量**，不使用 ?attr/ 或 @color/ 主题引用；
       运行时变化仅限文字（setTextColor）与显隐（setViewVisibility）；
    4. 不使用 RemoteViewsService / ListView 集合小组件。
  配色取自项目 docs/notification-mockup.html 的视觉语言（主文字 / 次要 / 强调
  三档；亮暗两套具体色值见各 TextView 的 android:textColor 字面量，
  强调色 #FF3482FF 深浅色共用）。
  圆环倒计时：鸿蒙版为 Progress(Ring)，RemoteViews 画不出环形，
  故降级为等义文本（标签行右侧「剩余 N 分钟」）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <!-- ── 标题行：今日课程                    第 12 周 · 第 1 学期 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="今日课程"
            android:textColor="#FF111111"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="今日课程" />

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF8A8A92"
            android:textSize="11sp"
            tools:text="第 12 周 · 第 1 学期" />
    </LinearLayout>

    <!-- ── 标签行：当前课程                    剩余 40 分钟 ────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF3482FF"
            android:textSize="11.5sp"
            tools:text="当前课程" />

        <TextView
            android:id="@+id/widget_remain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF8A8A92"
            android:textSize="11sp"
            tools:text="剩余 40 分钟" />
    </LinearLayout>

    <!-- ── 课程名（大字视觉焦点）────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF111111"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="高等数学" />

    <!-- ── 教室行 ──────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF8A8A92"
        android:textSize="11.5sp"
        tools:text="教室:A-301" />

    <!-- ── 下一节行 ────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF8A8A92"
        android:textSize="11.5sp"
        tools:text="下一节课是:大学英语 09:50" />
</LinearLayout>
