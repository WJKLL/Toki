<?xml version="1.0" encoding="utf-8"?>
<!--
  F-10 今日课程卡（4x2 = 250x110dp）。

  兼容性红线（v1.36.0 桌面小组件失败的复盘结论，务必保持）：
    1. ViewGroup 嵌套 ≤ 2 层：根 LinearLayout + 行/标题行 LinearLayout；
    2. 无 Bitmap、无 Canvas、无自定义 Drawable 绘制；
    3. 布局内颜色全部是**字面量**，不使用 ?attr/ 或 @color/ 主题引用；
       运行时颜色（含暗色）由 Flutter 侧下发、经 setTextColor 覆盖；
    4. 不使用 RemoteViewsService / ListView 集合小组件 —— 固定 3 行静态布局。
  固定 3 行：超出部分由 Flutter 侧在标题行给出「共 N 门」，不再增行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="14dp"
    android:paddingBottom="11dp">

    <!-- ── 标题行：今日课程 · 周三          共 4 门 ────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="今日课程 · 周三" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="#99000000"
            android:textSize="11sp"
            tools:text="共 4 门" />
    </LinearLayout>

    <!-- ── 课程行 1 ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_name1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1A1A1A"
            android:textSize="11sp"
            tools:text="高等数学" />

        <TextView
            android:id="@+id/widget_time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="#99000000"
            android:textSize="10sp"
            tools:text="08:00-09:40" />

        <TextView
            android:id="@+id/widget_room1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="76dp"
            android:textColor="#99000000"
            android:textSize="10sp"
            tools:text="A-301" />
    </LinearLayout>

    <!-- ── 课程行 2 ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_name2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1A1A1A"
            android:textSize="11sp"
            tools:text="大学英语" />

        <TextView
            android:id="@+id/widget_time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="#99000000"
            android:textSize="10sp"
            tools:text="10:00-11:40" />

        <TextView
            android:id="@+id/widget_room2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="76dp"
            android:textColor="#99000000"
            android:textSize="10sp"
            tools:text="B-202" />
    </LinearLayout>

    <!-- ── 课程行 3 ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_name3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1A1A1A"
            android:textSize="11sp"
            tools:text="数据结构" />

        <TextView
            android:id="@+id/widget_time3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="#99000000"
            android:textSize="10sp"
            tools:text="14:00-15:40" />

        <TextView
            android:id="@+id/widget_room3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="76dp"
            android:textColor="#99000000"
            android:textSize="10sp"
            tools:text="C-105" />
    </LinearLayout>

    <!-- ── 溢出脚注：… 等 N 门 ──────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#99000000"
        android:textSize="10sp"
        tools:text="… 等 2 门" />

    <!-- ── 空态（与 3 行互斥显示）────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:text="今日无课"
        android:textColor="#99000000"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
