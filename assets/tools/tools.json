{
  "categories": [
    {
      "id": "game",
      "name": "游戏",
      "icon": "play",
      "tools": [
        {
          "id": "steam_summary",
          "name": "Steam 用户",
          "summary": "查询公开资料、头像与在线状态",
          "icon": "custom:steam",
          "apiPath": "/api/v1/game/steam/summary",
          "method": "GET",
          "costCredits": 2,
          "params": [
            { "name": "steamid", "label": "Steam 标识", "type": "text", "placeholder": "ID / URL / 好友代码", "in": "query" }
          ],
          "displayType": "custom",
          "customRoute": "/steam"
        },
        {
          "id": "mc_server",
          "name": "MC 服务器",
          "summary": "查询服务器在线人数与状态",
          "apiPath": "/api/v1/game/minecraft/serverstatus",
          "method": "GET",
          "costCredits": 1,
          "params": [
            { "name": "server", "label": "服务器地址", "type": "text", "placeholder": "如 play.minedhype.com", "in": "query" }
          ],
          "displayType": "keyValue",
          "result": {
            "fields": [
              { "key": "online", "label": "在线" },
              { "key": "ip", "label": "地址" },
              { "key": "port", "label": "端口" },
              { "key": "players", "label": "玩家数" },
              { "key": "max_players", "label": "上限" }
            ]
          }
        }
      ]
    },
    {
      "id": "image",
      "name": "图片",
      "icon": "photos",
      "tools": [
        {
          "id": "bing_daily",
          "name": "必应每日壁纸",
          "summary": "必应每日高清壁纸",
          "apiPath": "/api/v1/image/bing-daily",
          "method": "GET",
          "costCredits": 1,
