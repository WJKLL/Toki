            "fields": [
              { "key": "content", "label": "一言" },
              { "key": "source", "label": "出处" },
              { "key": "author", "label": "作者" }
            ]
          }
        }
      ]
    },
    {
      "id": "text",
      "name": "文本",
      "icon": "notes",
      "tools": [
        {
          "id": "md5",
          "name": "MD5 哈希",
          "summary": "文本 MD5 摘要",
          "apiPath": "/api/v1/text/md5",
          "method": "GET",
          "costCredits": 1,
          "params": [
            { "name": "text", "label": "原文", "type": "text", "placeholder": "要哈希的文本", "in": "query" }
          ],
          "displayType": "text",
          "result": { "field": "md5" }
        },
        {
          "id": "base64_encode",
          "name": "Base64 编码",
          "summary": "文本编码为 Base64",
          "apiPath": "/api/v1/text/base64/encode",
          "method": "POST",
          "costCredits": 1,
          "params": [
            { "name": "text", "label": "原文", "type": "text", "placeholder": "hello world", "in": "body" }
          ],
          "displayType": "text",
          "result": { "field": "encoded" }
        },
        {
          "id": "base64_decode",
          "name": "Base64 解码",
          "summary": "Base64 还原为文本",
          "apiPath": "/api/v1/text/base64/decode",
          "method": "POST",
          "costCredits": 1,
          "params": [
            { "name": "text", "label": "Base64", "type": "text", "placeholder": "aGVsbG8gd29ybGQ=", "in": "body" }
          ],
          "displayType": "text",
          "result": { "field": "decoded" }
        },
        {
          "id": "aes_encrypt",
          "name": "AES 加密",
          "summary": "密钥文本对称加密",
          "apiPath": "/api/v1/text/aes/encrypt",
          "method": "POST",
          "costCredits": 2,
          "params": [
            { "name": "key", "label": "密钥", "type": "text", "placeholder": "任意字符串密钥", "in": "body" },
            { "name": "text", "label": "原文", "type": "text", "placeholder": "要加密的消息", "in": "body" }
          ],
          "displayType": "text",
          "result": { "field": "ciphertext" }
        },
        {
          "id": "aes_decrypt",
          "name": "AES 解密",
          "summary": "密文还原为原文",
          "apiPath": "/api/v1/text/aes/decrypt",
          "method": "POST",
          "costCredits": 2,
          "params": [
            { "name": "key", "label": "密钥", "type": "text", "placeholder": "与加密一致的密钥", "in": "body" },
            { "name": "text", "label": "密文", "type": "text", "placeholder": "粘贴 ciphertext", "in": "body" }
          ],
          "displayType": "text",
          "result": { "field": "plaintext" }
        }
      ]
    },
