          "costCredits": 1,
          "params": [
            { "name": "ip", "label": "目标 IP / 域名", "type": "text", "placeholder": "如 cn.bing.com", "in": "query" }
          ],
          "displayType": "keyValue",
          "result": {
            "fields": [
              { "key": "ip", "label": "IP" },
              { "key": "region", "label": "地区" },
              { "key": "isp", "label": "运营商" },
              { "key": "asn", "label": "ASN" },
              { "key": "llc", "label": "简称" }
            ]
          }
